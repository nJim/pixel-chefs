{
  "name": "pixel-chefs",
  "version": "1.0.0",
  "description": "A Jackbox-style multiplayer party game: guess which coworker is behind the pixels before the photo sharpens.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Jim Vomero (https://github.com/nJim)",
  "repository": {
    "type": "git",
    "url": "https://github.com/nJim/pixel-chefs.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "sf dev --state-backend sqlite",
    "fetch-team": "node scripts/fetch-team.mjs",
    "make-media": "node scripts/make-media.mjs",
    "typecheck": "tsc -p .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "deploy": "sf publish"
  },
  "dependencies": {
    "@spacefast/zero": "^0.8.0",
    "preact": "10.29.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "node-html-parser": "^7.0.1",
    "sharp": "^0.34.4",
    "typescript": "^6.0.3"
  }
}
